# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (Leave empty or use mongodb://localhost:27017/collegegpt for local MongoDB)
# If MongoDB is not running locally, server uses built-in in-memory fallback store so it works out of the box!
MONGODB_URI=mongodb://localhost:27017/collegegpt

# JWT Authentication
JWT_SECRET=collegegpt_super_secure_jwt_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# AI LLM Provider Configuration
# Supported providers: gemini | openai | groq | openrouter | local
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# OpenAI / Alternative LLM configs (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Embedding Model Configuration
# Supported providers: gemini | openai | local
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004

# Vector Database Configuration
# Supported stores: memory | pinecone | qdrant | mongodb
VECTOR_STORE_TYPE=memory

# Pinecone (Optional for Cloud Vector DB)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=collegegpt

# Qdrant (Optional for Qdrant Cloud/Local)
QDRANT_URL=
QDRANT_API_KEY=

# RAG Pipeline Tunables
RAG_TOP_K=5
RAG_MIN_SCORE=0.25
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# File Upload Settings
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=./uploads
