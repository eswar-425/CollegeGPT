{
  "name": "collegegpt",
  "version": "1.0.0",
  "description": "CollegeGPT - AI-Powered College Information Assistant with RAG",
  "main": "server/src/index.js",
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "cd server && npm run seed",
    "build": "cd client && npm run build"
  },
  "keywords": [
    "rag",
    "college-assistant",
    "ai",
    "gemini",
    "openai",
    "embeddings",
    "vector-database",
    "mern",
    "react",
    "nodejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eswar-425/CollegeGPT.git"
  },
  "homepage": "https://college-gpt-olive.vercel.app",
  "author": "CollegeGPT Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
